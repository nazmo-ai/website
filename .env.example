# Copy to .env and fill in.
#
# Apps Script web-app deployment URL that receives waitlist signups.
# See "Waitlist -> Google Sheets" in DEPLOY.md for how to create it.
# Must be a full /exec URL or the form stays closed.
VITE_WAITLIST_ENDPOINT=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXX/exec
